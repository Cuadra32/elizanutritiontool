{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/c/:slug/tool", "destination": "/tool.html?coach=:slug" },
    { "source": "/c/:slug", "destination": "/index.html?coach=:slug" }
  ]
}
